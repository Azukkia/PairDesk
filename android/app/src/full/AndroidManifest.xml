<?xml version="1.0" encoding="utf-8"?>
<!--
  "Full" edition only (see build.gradle.kts): the accessibility service that
  lets a computer control the phone. Google Play Protect blocks the
  installation of any app from outside a store that declares one, which is
  why the standard edition does not.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!--
          Applies the input of a computer the user accepted (taps, swipes,
          text, Back / Home / Recent apps). Enabled by the user in the
          accessibility settings; only bound by the system.
        -->
        <service
            android:name=".host.PairDeskAccessibilityService"
            android:exported="true"
            android:label="@string/accessibility_label"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service" />
        </service>
    </application>
</manifest>
