<?xml version="1.0" encoding="utf-8"?>
<!--
  Nothing is backed up nor transferred to a new device: the device ID must stay
  unique (two phones with the same ID would steal each other's sessions) and the
  stored passwords are encrypted with a key that never leaves this device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
