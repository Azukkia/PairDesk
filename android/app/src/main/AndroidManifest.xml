<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Signaling (MQTT over secure WebSocket, private server) and WebRTC media. -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Reconnects the relays as soon as the device's network comes back. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- WebRTC audio playback (audio shared by a computer). -->
    <uses-permission android:name="android.permission.MODIFY_AUDIO_SETTINGS" />
    <!--
      A session controlling a computer survives a short trip to another app
      (SessionService, foreground service of type specialUse).
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
    <!--
      The phone's camera streamed to a computer (webcam): the camera, kept
      running in the background by CameraService (type camera, Android 14+).
    -->
    <uses-permission android:name="android.permission.CAMERA" />
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_CAMERA" />
    <!--
      A computer viewing this phone: the screen capture runs in
      ScreenShareService (type mediaProjection), the screen stays on meanwhile.
    -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PROJECTION" />
    <uses-permission android:name="android.permission.WAKE_LOCK" />
    <!--
      Ongoing-session notifications and their End / Disconnect buttons,
      connection requests and chat messages while PairDesk is not on screen
      (Android 13+).
    -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.camera.any" android:required="false" />
    <uses-feature android:name="android.hardware.camera" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />

    <application
        android:name=".PairDeskApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.PairDesk">

        <!--
          Orientation and size changes are handled by Compose: the activity is
          not recreated, so a video surface showing a session keeps running.
        -->
        <activity
            android:name=".MainActivity"
            android:configChanges="orientation|screenSize|screenLayout|smallestScreenSize|keyboard|keyboardHidden|navigation"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
          Runs while the phone controls a computer. specialUse: a user-initiated
          remote desktop session matches none of the predefined types (see
          SessionService for the reasons); started only from the visible app.
        -->
        <service
            android:name=".session.SessionService"
            android:exported="false"
            android:foregroundServiceType="specialUse">
            <property
                android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
                android:value="Remote desktop session started by the user: keeps the end-to-end encrypted peer-to-peer connection to the computer the user controls alive while the user briefly switches to another app. Ends with the session, from the notification, or when the app is removed from the recent apps." />
        </service>

        <!-- The camera streamed to a computer keeps running in the background. -->
        <service
            android:name=".camera.CameraService"
            android:exported="false"
            android:foregroundServiceType="camera" />

        <!-- A computer views this phone: the screen capture (started after the user's consent). -->
        <service
            android:name=".host.ScreenShareService"
            android:exported="false"
            android:foregroundServiceType="mediaProjection" />


        <!-- Buttons of the PairDesk notifications (decline a request, end a session). -->
        <receiver
            android:name=".session.SessionActionReceiver"
            android:exported="false" />
    </application>
</manifest>
